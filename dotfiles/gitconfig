# Template gitconfig — copy to ~/.gitconfig and fill in user info
# Sensitive fields (email, signing keys) are NOT stored in this repo

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true
    default = simple

[fetch]
    prune = true

# Signed commits: uncomment after configuring a key
# [commit]
#     gpgsign = true
# [tag]
#     gpgsign = true
# [gpg]
#     format = ssh
# [user]
#     signingkey = ~/.ssh/id_ed25519.pub
# [gpg "ssh"]
#     allowedSignersFile = ~/.ssh/allowed_signers

[core]
    autocrlf = input
    editor = nano
    excludesfile = ~/.gitignore_global

[color]
    ui = auto

[diff]
    colorMoved = zebra

[alias]
    s = status --short --branch
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate --all
    last = log -1 HEAD --stat
    unstage = reset HEAD --

[safe]
    # Prevent "dubious ownership" errors in WSL/cross-mount scenarios
    # directory = *

[url "git@github.com:"]
    insteadOf = https://github.com/
